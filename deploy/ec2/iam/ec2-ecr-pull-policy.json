{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullDeploymentImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:<AWS_REGION>:<AWS_ACCOUNT_ID>:repository/hops-spring",
        "arn:aws:ecr:<AWS_REGION>:<AWS_ACCOUNT_ID>:repository/hops-ai",
        "arn:aws:ecr:<AWS_REGION>:<AWS_ACCOUNT_ID>:repository/hops-frontend"
      ]
    }
  ]
}

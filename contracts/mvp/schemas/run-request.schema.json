{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "mvp-1"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "inquiryId": {
      "type": "string",
      "format": "uuid"
    },
    "inquiryVersion": {
      "type": "integer",
      "minimum": 1
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "actorContext": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "departmentId": {
          "type": "string",
          "format": "uuid"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "userId",
        "departmentId",
        "roles"
      ],
      "additionalProperties": false
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sender": {
            "enum": [
              "USER",
              "ASSISTANT"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "messageId",
          "revision",
          "sender",
          "content"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "sender": {
                  "const": "USER"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "maxLength": 4000
                }
              }
            }
          }
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "anyOf": [
              {
                "enum": [
                  "ACCOUNT_AUTH",
                  "PERMISSION",
                  "NETWORK_ACCESS",
                  "SOFTWARE",
                  "BUSINESS_SERVICE_ERROR",
                  "OTHER"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Spring 문제 상태 코드. 공통 enum은 계약 리뷰에서 확정한다."
          },
          "questionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "summary",
          "category",
          "status",
          "questionCount"
        ],
        "additionalProperties": false
      }
    },
    "workItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "problemId": {
            "type": "string",
            "format": "uuid"
          },
          "workScope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Spring 생성 작업 상태 코드. 공통 enum은 계약 리뷰에서 확정한다."
          },
          "ticketId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "problemId",
          "workScope",
          "status",
          "ticketId"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "executionSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "modelCallSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "modelErrorRetries": {
          "type": "integer",
          "minimum": 0
        },
        "formatRepairRetries": {
          "type": "integer",
          "minimum": 0
        },
        "questionsPerProblem": {
          "const": 3
        }
      },
      "required": [
        "executionSeconds",
        "modelCallSeconds",
        "modelErrorRetries",
        "formatRepairRetries",
        "questionsPerProblem"
      ],
      "additionalProperties": false,
      "description": "실행 주체가 전달하는 예산 제안. 기존 fixture의 90/30초와 재시도 1회는 공통 기본값 승인이 아니다. 실제 상한과 deadline 일관성은 Runtime에서 검사한다."
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "inquiryId",
    "inquiryVersion",
    "deadlineAt",
    "actorContext",
    "departments",
    "messages",
    "problems",
    "workItems",
    "budget"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mvp-1 execution request (review draft)",
  "description": "PRD v1.41 및 docs/API.md 3절을 구체화하는 #22 리뷰 후보. 필드명·필수성은 승인 전이다."
}

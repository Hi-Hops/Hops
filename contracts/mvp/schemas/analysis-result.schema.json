{
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string",
                "pattern": "^new:.+$"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "anyOf": [
              {
                "enum": [
                  "ACCOUNT_AUTH",
                  "PERMISSION",
                  "NETWORK_ACCESS",
                  "SOFTWARE",
                  "BUSINESS_SERVICE_ERROR",
                  "OTHER"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "action": {
            "enum": [
              "ASK_USER",
              "PROPOSE_TICKETS",
              "OUT_OF_SCOPE"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "ref",
          "summary",
          "category",
          "action"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "ASK_USER"
                }
              }
            },
            "then": {
              "required": [
                "question"
              ]
            }
          }
        ]
      }
    },
    "ticketProposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string",
                "pattern": "^new:.+$"
              }
            ]
          },
          "problemRef": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string",
                "pattern": "^new:.+$"
              }
            ]
          },
          "workScope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "ACCOUNT_AUTH",
              "PERMISSION",
              "NETWORK_ACCESS",
              "SOFTWARE",
              "BUSINESS_SERVICE_ERROR",
              "OTHER"
            ]
          },
          "departmentCode": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "purpose": {
            "enum": [
              "INCIDENT",
              "CS_REVIEW"
            ]
          },
          "diagnosisSummary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "handoffReason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uncertainty": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "messageId": {
                  "type": "string",
                  "format": "uuid"
                },
                "messageRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "messageId",
                "messageRevision",
                "summary"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ref",
          "problemRef",
          "workScope",
          "title",
          "description",
          "category",
          "departmentCode",
          "purpose",
          "diagnosisSummary",
          "handoffReason",
          "uncertainty",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "purpose": {
                  "const": "CS_REVIEW"
                }
              }
            },
            "then": {
              "properties": {
                "departmentCode": {
                  "const": "CS"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "answer",
    "problems",
    "ticketProposals"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mvp-1 analysis result (review draft)"
}

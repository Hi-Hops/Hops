{
  "openapi": "3.1.0",
  "info": {
    "title": "Hops MVP 실행 전송 검토안",
    "version": "mvp-1-draft",
    "description": "#22 리뷰 후보. 경로·서비스 인증·최종 결과 전달은 승인 전이며 구현 완료가 아니다."
  },
  "security": [
    {
      "serviceBearer": []
    }
  ],
  "paths": {
    "/internal/agent-runs": {
      "post": {
        "operationId": "submitRun",
        "description": "팀 리뷰용 접수 계약. 실행과 티켓 저장 완료를 뜻하지 않는다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas/run-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "접수 상태",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "const": "QUEUED"
                    }
                  },
                  "required": [
                    "runId",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "서비스 인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "서비스 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "동일 실행 ID의 본문 충돌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "일시적 실행 서비스 장애",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/agent-runs/{runId}/events": {
      "get": {
        "operationId": "streamRun",
        "description": "미승인 제안: 진행과 최종 결과를 SSE로 전달. 종료 결과는 result 조회로 복구한다.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "각 SSE data는 Event 객체를 직렬화한 JSON 문자열이다. 종료 type은 result 또는 failed.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "서비스 인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "서비스 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "실행 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "일시적 실행 서비스 장애",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/agent-runs/{runId}/result": {
      "get": {
        "operationId": "getRunResult",
        "description": "미승인 제안: 보존한 동일 종료 이벤트를 반환하며 새 실행을 만들지 않는다.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "보존한 종료 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalEvent"
                }
              }
            }
          },
          "202": {
            "description": "실행이 아직 완료되지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "enum": [
                        "QUEUED",
                        "RUNNING"
                      ]
                    }
                  },
                  "required": [
                    "runId",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "서비스 인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "서비스 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "실행 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "일시적 실행 서비스 장애",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "사용자 JWT와 별도인 서비스 자격 증명 제안. 방식 확정 전."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "retryable"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": "mvp-1"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "inquiryId": {
            "type": "string",
            "format": "uuid"
          },
          "inquiryVersion": {
            "type": "integer",
            "minimum": 1
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "enum": [
              "progress",
              "result",
              "failed"
            ]
          },
          "payload": {}
        },
        "required": [
          "schemaVersion",
          "eventId",
          "runId",
          "inquiryId",
          "inquiryVersion",
          "occurredAt",
          "type",
          "payload"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "progress"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "stage": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "stage",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "result"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "schemas/analysis-result.schema.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "TerminalEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Event"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "result",
                  "failed"
                ]
              }
            }
          }
        ]
      }
    }
  }
}

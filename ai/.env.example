# ai/에서 .env로 복사한다. uv 직접 실행과 루트 Compose가 같은 파일을 읽는다.
# AI 서버 골격 설정. 비밀값은 이 예시 파일에 쓰지 않는다.
# scaffold: 생존 확인만 제공하며 업무 실행·검색·모델 연결은 미구현이다.
# real: 실제 연결 전이므로 시작을 거부한다. Fake로 대체하지 않는다.
HOPS_AI_MODE=scaffold

# 기본값은 내부 실행 API 비활성화다. 실제 실행기는 아직 준비되지 않았다.
HOPS_AI_INTERNAL_API_ENABLED=false
# 활성화할 때만 AI 전용 DB와 Spring→AI 서비스 토큰을 별도로 설정한다.
# Compose는 postgres:5432, 호스트 직접 실행은 localhost:POSTGRES_PORT로 접속한다.
HOPS_AI_RUNTIME_DSN=
# 최소 32바이트 난수를 base64url로 인코딩한 Spring→AI 토큰. AI→Spring 토큰과 공유하지 않는다.
AI_SERVICE_TOKEN=

# 모든 역할이 공유할 초기 실행 예산. 실제 모델·비용 측정 후 검토한다.
HOPS_AI_RUN_DEADLINE_SECONDS=60
HOPS_AI_LLM_CALL_TIMEOUT_SECONDS=30
HOPS_AI_MAX_LLM_CALLS=8
# LLM 일시 오류만 대상이다. 업무 저장·색인 반영 자동 재시도 설정이 아니다.
HOPS_AI_MAX_AUTO_RETRIES=2
HOPS_AI_MAX_OUTPUT_TOKENS=1500

# Spring이 요청할 수 있는 실행 한도의 서버 상한. 넘는 요청은 429로 접수하지 않는다.
HOPS_AI_MAX_RUN_INPUT_TOKENS=60000
HOPS_AI_MAX_TOOL_CALLS=10
# 한 인스턴스가 동시에 실행하는 run 수. 넘으면 429와 Retry-After로 응답한다.
# AI 서버는 한 인스턴스 운영을 전제로 한다. 여러 대로 늘리면 서비스 전체 상한이 별도로 필요하다.
HOPS_AI_MAX_CONCURRENT_RUNS=4

# 외부 연동 준비용(선택). 비워도 scaffold는 기동한다.
# OpenAI 호출·Langfuse 추적 연동 자체는 미구현이다. AI 컨테이너에만 전달한다.
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 사용하는 Langfuse 프로젝트의 리전 또는 자체 호스팅 주소.
LANGFUSE_BASE_URL=

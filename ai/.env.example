# AI 서버 환경변수 예시. 실제 값은 Git에서 제외되는 .env에 둔다. 비밀값은 이 파일에 쓰지 않는다.

# 실행 모드: fake(외부 연결 없는 가짜 구현) | real(실제 LLM·검색·도구)
HOPS_AI_MODE=fake
# 에이전트 구성: single(MVP 단일 에이전트) | multi(Supervisor + 4개 역할)
HOPS_AI_AGENT_MODE=single

# 실행 예산. 초기 기준값이며 실제 모델 측정 후 조정한다.
# 한 실행 전체 제한 시간(초). 역할이 바뀌어도 초기화하지 않는다.
HOPS_AI_RUN_DEADLINE_SECONDS=60
# 모델 호출 1회의 제한 시간(초)
HOPS_AI_LLM_CALL_TIMEOUT_SECONDS=30
# 한 실행에서 허용하는 모델 호출 상한. 자동 재시도도 포함한다.
HOPS_AI_MAX_LLM_CALLS_SINGLE=3
HOPS_AI_MAX_LLM_CALLS_MULTI=8
# 일시 오류에 대한 호출당 자동 재시도 횟수
HOPS_AI_MAX_AUTO_RETRIES=2
# 모델 호출 1회의 최대 출력 토큰
HOPS_AI_MAX_OUTPUT_TOKENS=1500

# 아래는 real 모드와 추적을 연결하는 후속 단계에서 사용한다.
# OPENAI_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ai/에서 .env로 복사한다. 루트 Compose가 이 파일을 자동으로 읽는다.
# AI 서버 골격 설정. 비밀값은 이 예시 파일에 쓰지 않는다.
# scaffold: 생존 확인만 제공하며 업무 실행·검색·모델 연결은 미구현이다.
# real: Supervisor와 전문 역할을 실제 OpenAI 모델로 실행한다. 내부 API 활성화, OPENAI_API_KEY, 모델이 모두 필요하며
#       Ticket 도구(기본 켜짐)를 위한 Spring 주소 HOPS_AI_SPRING_BASE_URL과 토큰 SPRING_SERVICE_TOKEN도 필요하다(아래 Ticket 절).
#       하나라도 없으면 시작을 거부한다(Fake로 대체하지 않는다).
HOPS_AI_MODE=scaffold
# real 모드에서 쓸 OpenAI 모델
HOPS_AI_SUPERVISOR_MODEL=gpt-6-luna

# real 모드의 Ticket은 Spring 도구로 생성·결과 확인까지 수행한다.
# false는 명시적인 제안 전용 실행이며 저장 성공을 표시하지 않는다.
HOPS_AI_TICKET_TOOLS_ENABLED=true
# [real 모드 필수] Ticket 도구(위 값이 true)와 HOPS_AI_KNOWLEDGE_SOURCE=spring은 Spring 내부 API를 부른다.
# 아래 두 값 중 하나라도 없으면 real 모드는 시작을 거부한다. scaffold에서는 필요 없고 비워 두면 미설정으로 본다.
# - HOPS_AI_SPRING_BASE_URL: Compose는 기본값 http://backend:8080을 쓰므로 이 줄을 켜지 않는다.
#   컨테이너 안의 localhost는 AI 자신이라 Compose에서 http://localhost:8080을 넣으면 Spring에 닿지 못한다.
#   AI를 호스트에서 직접 실행할 때만 켜서 Spring의 호스트 주소(예: http://localhost:8080)를 넣는다.
# - SPRING_SERVICE_TOKEN: AI→Spring 전용 토큰으로 AI_SERVICE_TOKEN(Spring→AI)과 다른 값이다. 받는 쪽인
#   Spring의 backend/spring/hops/.env에 두면 Compose가 AI에도 같은 값을 전달한다. 호스트에서 AI를 직접 실행하면
#   아래 줄을 켜거나 프로세스 환경변수로 같은 값을 넣고, Spring에도 같은 값을 설정한다. 값 만들기:
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
# HOPS_AI_SPRING_BASE_URL=http://localhost:8080
# SPRING_SERVICE_TOKEN=<Spring과 같은 값. 32바이트 이상 난수의 padding 없는 base64url>
HOPS_AI_TICKET_HTTP_TIMEOUT_SECONDS=5
HOPS_AI_TICKET_MAX_QUERIES=4
HOPS_AI_TICKET_MAX_ATTEMPTS=3
HOPS_AI_TICKET_POLL_INTERVAL_SECONDS=0.25
# Knowledge 역할이 쓸 검색 자료. none: 연결하지 않음(기본), fixture: 개발용 고정 가이드(SYNTHETIC),
# spring: Spring 내부 API로 DB의 승인 문서를 읽음(HOPS_AI_SPRING_BASE_URL과 SPRING_SERVICE_TOKEN 필요).
# fixture는 사용법 문의의 안내 흐름을 확인하는 용도이며 검색 품질이나 운영 지식을 뜻하지 않는다.
HOPS_AI_KNOWLEDGE_SOURCE=none
# true이면 상담을 문제별 행동 경로로 처리한다(근거 충분성 판정, 분석과 질문 분리, 문제별 행동 선택,
# 질문 문장 생성, Spring 연결 시 관계 조회). 판정이 검색 결과가 있는 문제마다, 질문이 나가는 실행마다
# 모델을 한 번씩 더 부른다. 실제 Spring 검색·관계 조회와 붙여 검증하기 전이라 기본은 false다.
HOPS_AI_KNOWLEDGE_ASSESSMENT=false
# true이면 Knowledge 안내문을 승인 본문 전체가 아니라 문의에 답하는 문단만 골라 만든다. 모델은 문단 번호만
# 고르고 문장을 쓰지 않는다. 답하는 문서가 없다고 판단하면 안내하지 않고 담당자 검토로 넘긴다. 안내 후보가
# 있을 때 모델을 한 번 더 부르며, 모델 오류·예산 부족이면 본문 전체로 안내한다. Knowledge가 연결됐을 때만 쓴다.
HOPS_AI_GUIDE_EXCERPT=true
# Spring 지식 검색·관계 조회 요청 한 번의 제한 시간(초). 남은 실행 기한보다 오래 기다리지 않는다.
HOPS_AI_KNOWLEDGE_HTTP_TIMEOUT_SECONDS=5

# 승인 사례 색인(POST /internal/v2/index-jobs). 아래 값과 OPENAI_API_KEY, Spring 주소·토큰, RunLedger가
# 모두 있어야 색인을 받는다. 없으면 503 INDEX_UNAVAILABLE이다. 권한은 ai/db/04_search_chunk_privileges.sql.
# HOPS_AI_SEARCH_DSN=postgresql://hops_ai_app:<비밀번호>@postgres:5432/hops
# HOPS_AI_NEO4J_URL=http://neo4j:7474
# HOPS_AI_NEO4J_PASSWORD=
# HOPS_AI_NEO4J_USERNAME=neo4j
# HOPS_AI_NEO4J_DATABASE=neo4j

# 기본값은 내부 실행 API 비활성화다. 실제 실행기는 아직 준비되지 않았다.
HOPS_AI_INTERNAL_API_ENABLED=false
# 활성화할 때만 AI 전용 DB와 Spring→AI 서비스 토큰을 별도로 설정한다.
# Compose는 postgres:5432, 호스트 직접 실행은 localhost:POSTGRES_PORT로 접속한다.
# 앱 계정 hops_ai_app으로 접속한다. 계정 준비는 ai/db/README.md를 따른다.
# HOPS_AI_RUNTIME_DSN=postgresql://hops_ai_app:<앱 계정 비밀번호>@postgres:5432/hops_ai_runtime
# AI_SERVICE_TOKEN=<최소 32바이트 난수를 base64url로 인코딩한 Spring→AI 토큰. 받는 쪽인 이 파일에 두면 Compose가 Spring에도 전달한다>

# 모든 역할이 공유할 초기 실행 예산. 실제 모델·비용 측정 후 검토한다.
HOPS_AI_RUN_DEADLINE_SECONDS=60
HOPS_AI_LLM_CALL_TIMEOUT_SECONDS=30
HOPS_AI_MAX_LLM_CALLS=8
# LLM 일시 오류만 대상이다. 업무 저장·색인 반영 자동 재시도 설정이 아니다.
HOPS_AI_MAX_AUTO_RETRIES=2
HOPS_AI_MAX_OUTPUT_TOKENS=1500

# Spring이 요청할 수 있는 실행 한도의 서버 상한. 넘는 요청은 429로 접수하지 않는다.
HOPS_AI_MAX_RUN_INPUT_TOKENS=60000
HOPS_AI_MAX_TOOL_CALLS=10
# 한 인스턴스가 동시에 실행하는 run 수. 넘으면 429와 Retry-After로 응답한다.
# AI 서버는 한 인스턴스 운영을 전제로 한다. 여러 대로 늘리면 서비스 전체 상한이 별도로 필요하다.
HOPS_AI_MAX_CONCURRENT_RUNS=4
# RunLedger 주기 작업 간격(초). 중단된 다른 인스턴스의 run 복구, 보존 기간(24시간)이 지난 결과 상세 만료.
# HOPS_AI_LEDGER_RECOVERY_INTERVAL_SECONDS=60
# HOPS_AI_LEDGER_EXPIRY_INTERVAL_SECONDS=3600

# 외부 연동 준비용(선택). 비워도 scaffold는 기동한다.
# AI 컨테이너에만 전달한다.
# 실제 문의를 받는 배포 환경에서는 HOPS_AI_LANGFUSE_CAPTURE_CONTENT=false로 유지한다.
# 가상 데이터 전용 환경에서 모델 입출력과 질문·답변 원문을 확인할 때만 true로 설정한다.
# HOPS_AI_LANGFUSE_CAPTURE_CONTENT=false
# OPENAI_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# 사용하는 Langfuse 프로젝트의 리전 또는 자체 호스팅 주소.
# LANGFUSE_BASE_URL=
# AI의 호스트 공개 포트를 변경할 때만 설정한다.
# AI_PORT=8000

          "type": "boolean",
          "const": true
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "target": {
          "$ref": "#/$defs/SubscriptionTarget"
        }
      },
      "required": [
        "ok",
        "requestId",
        "target"
      ],
      "additionalProperties": false
    },

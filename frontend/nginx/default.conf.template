server {
    listen 80;
    server_name ${HOPS_PUBLIC_HOST};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${HOPS_PUBLIC_HOST};

    ssl_certificate /etc/letsencrypt/live/${HOPS_PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${HOPS_PUBLIC_HOST}/privkey.pem;

    location = /api/v2/realtime/events {
        proxy_pass http://hops-spring:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # Swagger 문서는 공개하며 API 인증·권한은 Spring이 검사한다.
    location ~ ^/(swagger-ui(?:\.html|/.*)|v3/api-docs(?:\.yaml|/.*)?)$ {
        proxy_pass http://hops-spring:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v2/ {
        proxy_pass http://hops-spring:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /srv;
        try_files $uri $uri/ /index.html;
    }
}

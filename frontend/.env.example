# frontend/에서 .env로 복사한다. 루트 Compose가 이 파일을 자동으로 읽는다.
# VITE_ 값은 브라우저에 공개된다. 실제 비밀번호·API 키·토큰을 넣지 않는다.
VITE_DATA_MODE=live
# 이미지 첨부는 AI 연동과 운영 검증 전까지 기본 비활성이다.
VITE_CHAT_IMAGE_ATTACHMENTS=false
FRONTEND_PORT=5173
# 브라우저가 접근하는 Spring origin. 컨테이너 이름 backend를 사용하지 않는다.
# Compose에서는 비워두면 Backend의 BACKEND_PORT 기준 주소를 사용한다.
# Vite 직접 실행에서는 http://localhost:8080 등 실제 Spring origin을 입력한다.
VITE_API_BASE_URL=

# Mock 모드 전용 가상 계정. 실제 인증 계정과 구분한다.
# 한 계정으로 체험하려면 PREVIEW_ID와 PASSWORD를 입력한다.
# 역할별 검사는 PREVIEW_ID를 비우고 서로 다른 ID 네 개와 PASSWORD를 입력한다.
VITE_MOCK_PREVIEW_ID=
VITE_MOCK_PASSWORD=
VITE_MOCK_REQUESTER_ID=
VITE_MOCK_NETWORK_ID=
VITE_MOCK_BACKEND_ID=
VITE_MOCK_ADMIN_ID=

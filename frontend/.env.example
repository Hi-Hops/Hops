# mock: 서버 없이 가상 데이터 / live: 아래 두 서버에 실제 요청
VITE_DATA_MODE=mock
# live에서는 브라우저에서 접근 가능한 서버 origin(http(s)://호스트:포트)을 입력한다.
# /api를 붙이지 않는다. 비워도 Mock으로 자동 전환하지 않는다.
VITE_API_BASE_URL=

# mock에서만 사용. 이 파일을 .env로 복사하고 가상 로그인 값만 입력한다.
# VITE_ 값은 브라우저에 전달되므로 실제 계정·비밀번호·API 키를 넣지 않는다.
# 한 계정으로 채팅·내 문의·전체 부서 티켓·관리자 조회를 체험하려면 아래 두 값만 입력한다.
VITE_MOCK_PREVIEW_ID= # 예: mock.preview
VITE_MOCK_PASSWORD= # 예: mock-test-password

# 역할별 권한을 따로 테스트하려면 PREVIEW_ID를 비우고 아래 네 아이디와 위 비밀번호를 입력한다.
# 네 아이디는 서로 달라야 한다. PREVIEW_ID가 있으면 아래 역할별 계정은 사용하지 않는다.
VITE_MOCK_REQUESTER_ID= # 예: mock.requester
VITE_MOCK_NETWORK_ID= # 예: mock.network
VITE_MOCK_BACKEND_ID= # 예: mock.backend
VITE_MOCK_ADMIN_ID= # 예: mock.admin

# 호스트에서 접속할 Docker 포트. 비우면 5173.
FRONTEND_PORT=5173

# 선택 사항: 루트 .env에는 Compose의 호스트 공개 포트만 둔다.
# 기본 포트를 쓰면 복사하지 않아도 된다. 앱 설정·비밀값은 각 서비스의 .env에 둔다.
# BACKEND_PORT 변경 시 frontend/.env의 VITE_API_BASE_URL도 변경한다.
# FRONTEND_PORT 변경 시 backend/spring/hops/.env의 HOPS_CORS_ALLOWEDORIGINS도 변경한다.
# POSTGRES_PORT는 호스트 직접 접속에만 사용한다. 컨테이너끼리는 postgres:5432로 접속한다.
FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_PORT=8000
POSTGRES_PORT=5432

# 저장소 루트에서 이 파일을 .env로 한 번만 복사하고 Docker 설정을 모두 입력한다.
# 필수 입력: POSTGRES_PASSWORD, HOPS_JWT_SECRET. 나머지는 아래 기본값을 사용한다.

# PostgreSQL
POSTGRES_DB=hops
POSTGRES_USER=hops
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Spring
# ASCII 기준 32자 이상인 임의의 비밀키. 브라우저용 VITE_ 변수에 넣지 않는다.
HOPS_JWT_SECRET=
BACKEND_PORT=8080
HOPS_AGENT_BASEURL=http://ai:8000
# 비워두면 FRONTEND_PORT 기준 localhost·127.0.0.1 Origin을 허용한다.
HOPS_CORS_ALLOWEDORIGINS=

# Frontend
FRONTEND_PORT=5173
VITE_DATA_MODE=live
# 비워두면 http://localhost:BACKEND_PORT를 사용한다.
VITE_API_BASE_URL=
# Mock 모드에서만 사용한다. 실제 계정·비밀번호·API 키를 넣지 않는다.
# 한 계정으로 체험하려면 PREVIEW_ID와 PASSWORD를 입력한다.
# 역할별로 검사하려면 PREVIEW_ID를 비우고 서로 다른 역할별 ID 네 개와 PASSWORD를 입력한다.
VITE_MOCK_PREVIEW_ID=
VITE_MOCK_PASSWORD=
VITE_MOCK_REQUESTER_ID=
VITE_MOCK_NETWORK_ID=
VITE_MOCK_BACKEND_ID=
VITE_MOCK_ADMIN_ID=

# AI: 현재 scaffold만 기동 가능하며 실제 모델·검색은 미구현이다.
AI_PORT=8000
HOPS_AI_MODE=scaffold
HOPS_AI_RUN_DEADLINE_SECONDS=60
HOPS_AI_LLM_CALL_TIMEOUT_SECONDS=30
HOPS_AI_MAX_LLM_CALLS=8
HOPS_AI_MAX_AUTO_RETRIES=2
HOPS_AI_MAX_OUTPUT_TOKENS=1500

  "terms": [
    {"term_id": "TERM-001", "term": "API", "aliases": ["응용 프로그램 인터페이스"], "definition": "화면이나 다른 시스템이 서버 기능과 데이터를 요청하는 약속된 통신 경로.", "category": "WEB", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-002", "term": "HTTP 500", "aliases": ["500 오류", "Internal Server Error"], "definition": "서버가 요청을 처리하는 중 내부 오류가 발생했음을 나타내는 HTTP 상태. 이것만으로 원인은 확정할 수 없다.", "category": "WEB", "related_components": ["PORTAL_API", "PORTAL_DB"]},
    {"term_id": "TERM-003", "term": "X-Request-Id", "aliases": ["요청 추적 번호", "requestId"], "definition": "사용자 응답과 서버 로그의 같은 요청 한 건을 연결하는 식별자.", "category": "OBSERVABILITY", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-004", "term": "구조화 로그", "aliases": ["JSON 로그"], "definition": "시간·요청 ID·경로·상태·예외 같은 값을 필드로 나눠 기계가 검색하기 쉽게 기록한 로그.", "category": "OBSERVABILITY", "related_components": ["PORTAL_API", "PORTAL_DB"]},
    {"term_id": "TERM-005", "term": "스택 지문", "aliases": ["stack trace fingerprint"], "definition": "민감한 전체 스택을 노출하지 않고 같은 예외 발생 위치를 비교하기 위한 축약 식별값.", "category": "OBSERVABILITY", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-006", "term": "메트릭", "aliases": ["metrics"], "definition": "요청 수·오류 수·연결 수처럼 시간에 따라 집계되는 수치형 관측값.", "category": "OBSERVABILITY", "related_components": ["PORTAL_API", "PORTAL_DB"]},
    {"term_id": "TERM-007", "term": "커넥션 풀", "aliases": ["DB 연결 풀", "connection pool"], "definition": "애플리케이션이 DB 연결을 매번 새로 만들지 않고 재사용하도록 보관하는 연결 집합.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-008", "term": "HikariCP", "aliases": ["Hikari"], "definition": "Demo Portal의 Spring 애플리케이션에서 사용하는 JDBC 커넥션 풀 구현체.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-009", "term": "active connection", "aliases": ["사용 중 연결"], "definition": "커넥션 풀에서 현재 애플리케이션 작업이 점유하고 있는 DB 연결.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-010", "term": "idle connection", "aliases": ["유휴 연결"], "definition": "풀에 있으나 현재 작업이 사용하지 않아 즉시 빌려줄 수 있는 DB 연결.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-011", "term": "pending connection request", "aliases": ["연결 대기 요청"], "definition": "풀에서 사용할 연결이 없어 반환을 기다리는 애플리케이션 요청.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-012", "term": "connectionTimeout", "aliases": ["연결 획득 제한시간"], "definition": "커넥션 풀에서 연결을 기다릴 수 있는 최대 시간. 초과 시 연결 획득 오류가 발생한다.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-013", "term": "maximumPoolSize", "aliases": ["풀 최대 크기"], "definition": "HikariCP가 보유할 수 있는 idle과 active 연결의 최대 합계.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-014", "term": "leak detection", "aliases": ["연결 누수 탐지"], "definition": "연결이 설정된 시간보다 오래 풀에 반환되지 않을 때 누수 가능성을 알리는 보조 경고. 실제 반환 여부와 코드 경로를 확인하기 전 누수로 확정하지 않는다.", "category": "DATABASE", "related_components": ["PORTAL_API"]},
    {"term_id": "TERM-015", "term": "max_connections", "aliases": ["DB 최대 연결 수"], "definition": "PostgreSQL 서버가 동시에 허용하는 최대 연결 수 설정.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-016", "term": "reserved connection", "aliases": ["예약 연결 슬롯"], "definition": "일반 연결이 가득 찬 상황에서도 복구용 권한 사용자가 접속할 수 있도록 남겨 두는 PostgreSQL 연결 슬롯.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-017", "term": "pg_stat_activity", "aliases": ["세션 활동 뷰"], "definition": "PostgreSQL 서버 프로세스별 현재 활동·상태·대기 이벤트를 보여주는 시스템 뷰.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-018", "term": "numbackends", "aliases": ["현재 DB 연결 수"], "definition": "특정 데이터베이스에 현재 연결된 backend 프로세스 수.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-019", "term": "트랜잭션", "aliases": ["transaction"], "definition": "여러 DB 작업을 하나의 성공 또는 실패 단위로 처리하는 범위.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-020", "term": "idle in transaction", "aliases": ["트랜잭션 열린 유휴 상태"], "definition": "트랜잭션은 끝나지 않았지만 현재 쿼리를 실행하지 않는 세션 상태. 장시간 유지되면 잠금을 보유할 수 있다.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-021", "term": "Lock wait", "aliases": ["잠금 대기"], "definition": "다른 트랜잭션이 보유한 충돌 잠금이 해제될 때까지 현재 작업이 기다리는 상태.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-022", "term": "Deadlock", "aliases": ["교착 상태"], "definition": "둘 이상의 트랜잭션이 서로가 가진 잠금을 기다려 진행할 수 없는 순환 대기. PostgreSQL은 하나를 중단해 해소한다.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-023", "term": "blocker", "aliases": ["차단 세션"], "definition": "다른 세션이 필요한 잠금을 보유해 해당 세션을 기다리게 하는 트랜잭션 또는 세션.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-024", "term": "waiter", "aliases": ["대기 세션"], "definition": "필요한 잠금을 얻지 못해 blocker가 끝나기를 기다리는 세션.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-025", "term": "Slow Query", "aliases": ["느린 쿼리"], "definition": "기준 시간보다 오래 실행돼 사용자 응답 지연에 영향을 줄 수 있는 DB 작업. 한 번의 지연과 반복되는 문제를 구분해야 한다.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-026", "term": "query_id", "aliases": ["쿼리 식별자"], "definition": "SQL 원문을 직접 노출하지 않고 같은 형태의 PostgreSQL 쿼리를 묶어 비교하는 식별자.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-027", "term": "pg_stat_statements", "aliases": ["쿼리 통계 확장"], "definition": "query_id별 호출 수와 누적·평균·최대 실행시간 등을 집계하는 PostgreSQL 확장.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-028", "term": "실행계획", "aliases": ["query plan"], "definition": "PostgreSQL이 테이블과 인덱스를 어떤 순서와 방식으로 읽을지 정한 계획.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-029", "term": "Seq Scan", "aliases": ["순차 스캔"], "definition": "테이블의 행을 넓게 순서대로 읽는 실행계획 노드. 항상 문제는 아니며 데이터량과 조건을 함께 봐야 한다.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-030", "term": "Index Scan", "aliases": ["인덱스 스캔"], "definition": "인덱스를 이용해 조건에 맞는 행을 찾아가는 실행계획 노드. 사용 자체가 항상 빠른 처리를 보장하지는 않는다.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-031", "term": "EXPLAIN", "aliases": [], "definition": "쿼리를 실제 실행하지 않고 PostgreSQL이 선택한 예상 실행계획을 확인하는 명령.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-032", "term": "EXPLAIN ANALYZE", "aliases": [], "definition": "쿼리를 실제 실행해 실제 행 수와 시간을 포함한 실행계획을 확인하는 명령. 승인된 읽기 SELECT와 안전한 환경에서만 사람이 사용한다.", "category": "DATABASE", "related_components": ["PORTAL_DB"]},
    {"term_id": "TERM-033", "term": "RAG", "aliases": ["Retrieval-Augmented Generation", "검색 증강 생성"], "definition": "질문과 관련된 승인 문서를 먼저 검색한 뒤 그 근거를 LLM에 제공해 답변을 만드는 방식.", "category": "AI", "related_components": []},
    {"term_id": "TERM-034", "term": "청크", "aliases": ["chunk"], "definition": "검색과 권한 검증을 위해 문서를 의미 단위로 나눈 조각.", "category": "AI", "related_components": []},
    {"term_id": "TERM-035", "term": "임베딩", "aliases": ["embedding"], "definition": "문장이나 문서를 의미 유사도 검색에 사용할 숫자 벡터로 변환한 값.", "category": "AI", "related_components": []},
    {"term_id": "TERM-036", "term": "MFA", "aliases": ["Multi-Factor Authentication", "다단계 인증"], "definition": "비밀번호 외에 인증 앱·문자·보안 키 같은 추가 수단을 함께 확인하는 인증 방식.", "category": "IDENTITY", "related_components": ["MFA"]},
    {"term_id": "TERM-037", "term": "SSO", "aliases": ["Single Sign-On", "통합 로그인"], "definition": "한 번의 조직 인증으로 권한이 허용된 여러 사내 서비스에 접근하게 하는 로그인 방식.", "category": "IDENTITY", "related_components": ["SSO"]},
    {"term_id": "TERM-038", "term": "AADSTS 오류 코드", "aliases": ["AADSTS"], "definition": "Microsoft Entra ID 로그인 과정에서 실패 단계와 유형을 구분하기 위해 반환하는 오류 코드. 정확한 코드별 의미를 확인해야 한다.", "category": "IDENTITY", "related_components": ["SSO"]},
    {"term_id": "TERM-039", "term": "VPN", "aliases": ["Virtual Private Network", "가상 사설망"], "definition": "외부 네트워크에서 암호화된 연결을 통해 허용된 사내 자원에 접근하는 방식.", "category": "NETWORK", "related_components": ["VPN"]},
    {"term_id": "TERM-040", "term": "Always On VPN", "aliases": ["AOVPN"], "definition": "Windows 관리형 프로필을 사용해 조직 정책에 따라 사내망 연결을 제공하는 원격 접속 구성.", "category": "NETWORK", "related_components": ["VPN"]},
    {"term_id": "TERM-041", "term": "IKEv2", "aliases": ["Internet Key Exchange version 2"], "definition": "VPN 연결의 보안 협상과 키 교환에 사용하는 프로토콜. Hops 가상 기업 VPN의 표준 프로토콜이다.", "category": "NETWORK", "related_components": ["VPN"]},
    {"term_id": "TERM-042", "term": "RRAS", "aliases": ["Routing and Remote Access Service", "라우팅 및 원격 액세스"], "definition": "Windows Server에서 VPN 연결과 원격 액세스를 제공하는 서버 역할.", "category": "NETWORK", "related_components": ["VPN"]},
    {"term_id": "TERM-043", "term": "NPS", "aliases": ["Network Policy Server", "네트워크 정책 서버"], "definition": "VPN 같은 네트워크 접속 요청에 조직의 인증·권한 정책을 적용하는 Windows Server 역할.", "category": "NETWORK", "related_components": ["VPN"]},
    {"term_id": "TERM-044", "term": "RasClient 이벤트", "aliases": ["RasClient"], "definition": "Windows 원격 접속 클라이언트가 VPN 연결 결과와 오류 코드를 기록하는 이벤트 로그.", "category": "OBSERVABILITY", "related_components": ["VPN"]},
    {"term_id": "TERM-045", "term": "WAN Miniport", "aliases": ["WAN 미니포트"], "definition": "Windows가 VPN 같은 원격 접속 프로토콜을 처리할 때 사용하는 가상 네트워크 어댑터 계층.", "category": "NETWORK", "related_components": ["VPN"]},
    {"term_id": "TERM-046", "term": "SMB", "aliases": ["Server Message Block"], "definition": "Windows 환경에서 네트워크를 통해 파일과 폴더를 공유할 때 사용하는 프로토콜.", "category": "FILE_SHARE", "related_components": ["SMB"]},
    {"term_id": "TERM-047", "term": "UNC 경로", "aliases": ["Universal Naming Convention", "네트워크 공유 경로"], "definition": "두 개의 역슬래시로 시작해 서버 이름과 공유 이름을 나타내는 Windows 네트워크 경로 형식.", "category": "FILE_SHARE", "related_components": ["SMB"]},
    {"term_id": "TERM-048", "term": "TCP 445", "aliases": ["SMB 포트 445"], "definition": "현대 Windows SMB 파일 공유 연결에 사용하는 기본 TCP 포트. 도달 실패만으로 서버와 중간 네트워크 중 어느 쪽 문제인지 확정할 수 없다.", "category": "NETWORK", "related_components": ["SMB"]},
    {"term_id": "TERM-049", "term": "공유 권한", "aliases": ["share permission"], "definition": "SMB 공유에 접속한 사용자나 그룹이 네트워크를 통해 수행할 수 있는 작업을 제한하는 권한.", "category": "FILE_SHARE", "related_components": ["SMB"]},
    {"term_id": "TERM-050", "term": "NTFS 권한", "aliases": ["NTFS permission"], "definition": "Windows 파일 시스템에서 사용자나 그룹의 파일·폴더 읽기, 쓰기, 수정 같은 동작을 제한하는 권한.", "category": "FILE_SHARE", "related_components": ["SMB"]}
  ]
}

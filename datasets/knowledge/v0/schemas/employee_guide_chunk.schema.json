{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hops.local/schemas/employee_guide_chunk.v0.json",
  "title": "Employee Guide Chunk v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "chunk_id", "document_id", "version_no", "chunk_no",
    "document_type", "service_id", "section_id", "title", "content",
    "content_sha256", "source_content_sha256", "access_scope", "exposure_policy",
    "ingest_status", "content_review_status", "team_review_status", "evidence_ids",
    "source_policy_ids", "related_runbook_ids", "source_path"
  ],
  "properties": {
    "schema_version": {"const": "employee_guide_chunk.v0"},
    "chunk_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "pattern": "^GUIDE-[A-Z0-9-]+$"},
    "version_no": {"type": "integer", "minimum": 1},
    "chunk_no": {"type": "integer", "minimum": 1},
    "document_type": {"const": "EMPLOYEE_GUIDE"},
    "service_id": {"enum": ["IDENTITY", "REMOTE_ACCESS", "FILE_SHARE", "PORTAL", "COMMON"]},
    "section_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "access_scope": {"const": "EMPLOYEE"},
    "exposure_policy": {"const": "QUOTABLE"},
    "ingest_status": {"enum": ["PENDING", "APPROVED", "BLOCKED"]},
    "content_review_status": {"enum": ["AI_DRAFT", "OWNER_CONFIRMED", "REJECTED"]},
    "team_review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]},
    "evidence_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(PE-[0-9]{3}[A-D]?|GE-[0-9]{3})$"}
    },
    "source_policy_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "related_runbook_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RB-[A-Z0-9-]+$"}
    },
    "source_path": {"type": "string", "minLength": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hops.local/schemas/knowledge_policy_chunk.v0.json",
  "title": "Hops Knowledge POLICY chunk v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chunk_id", "policy_id", "document_type", "version_no", "chunk_no", "section_id", "title", "content", "content_sha256", "source_content_sha256", "access_scope", "exposure_policy", "ingest_status", "content_review_status", "team_review_status", "rule_ids", "source_policy_ids", "source_path"],
  "properties": {
    "schema_version": {"const": "knowledge_policy_chunk.v0"},
    "chunk_id": {"type": "string", "pattern": "^POLICY-[A-Z0-9-]+:v[0-9]+:c[0-9]{2}$"},
    "policy_id": {"type": "string", "pattern": "^POLICY-[A-Z0-9-]+$"},
    "document_type": {"const": "POLICY"},
    "version_no": {"type": "integer", "minimum": 1},
    "chunk_no": {"type": "integer", "minimum": 1},
    "section_id": {"enum": ["overview", "rules"]},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "access_scope": {"const": "STAFF"},
    "exposure_policy": {"const": "INTERNAL_ONLY"},
    "ingest_status": {"enum": ["PENDING", "APPROVED", "BLOCKED"]},
    "content_review_status": {"enum": ["AI_DRAFT", "OWNER_CONFIRMED", "REJECTED"]},
    "team_review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]},
    "rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RULE-[A-Z0-9-]+$"}},
    "source_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_path": {"type": "string", "pattern": "^documents/policies/.+\\.json$"}
  }
}

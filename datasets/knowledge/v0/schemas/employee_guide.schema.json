{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hops.local/schemas/employee_guide.v0.json",
  "title": "Hops EMPLOYEE_GUIDE v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "guide_id", "version_no", "title", "language", "status", "document_type", "service_id", "access", "applies_when", "user_phrases", "steps", "stop_and_handoff", "information_to_collect", "do_not_do", "related_runbook_ids", "provenance", "review"],
  "properties": {
    "schema_version": {"const": "employee_guide.v0"},
    "guide_id": {"type": "string", "pattern": "^GUIDE-[A-Z0-9-]+$"},
    "version_no": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"const": "ko"},
    "status": {"enum": ["DRAFT", "APPROVED", "DEPRECATED"]},
    "document_type": {"const": "EMPLOYEE_GUIDE"},
    "service_id": {"enum": ["IDENTITY", "REMOTE_ACCESS", "FILE_SHARE", "PORTAL", "COMMON"]},
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["access_scope", "exposure_policy", "ingest_status"],
      "properties": {
        "access_scope": {"const": "EMPLOYEE"},
        "exposure_policy": {"const": "QUOTABLE"},
        "ingest_status": {"enum": ["PENDING", "APPROVED", "BLOCKED"]}
      }
    },
    "applies_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "user_phrases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["order", "instruction", "expected_result"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "instruction": {"type": "string", "minLength": 1},
          "expected_result": {"type": "string", "minLength": 1}
        }
      }
    },
    "stop_and_handoff": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "information_to_collect": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "do_not_do": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_runbook_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RB-[A-Z0-9-]+$"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_evidence_ids", "created_at"],
      "properties": {
        "source_type": {"enum": ["SYNTHESIZED_FROM_APPROVED_SOURCE_EVIDENCE", "SYNTHESIZED_FROM_APPROVED_RUNBOOK_EVIDENCE", "SYNTHESIZED_FROM_PROJECT_POLICY"]},
        "source_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(PE-[0-9]{3}[A-D]?|GE-[0-9]{3})$"}},
        "source_policy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "created_at": {"type": "string", "format": "date"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["content_status", "reviewer", "reviewed_at", "team_review_status"],
      "properties": {
        "content_status": {"enum": ["AI_DRAFT", "OWNER_CONFIRMED", "REJECTED"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date"},
        "team_review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hops.local/schemas/reference_chunk.v0.json",
  "title": "Knowledge Reference Chunk v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "chunk_id", "reference_id", "reference_type", "chunk_no",
    "document_type", "title", "content", "content_sha256", "source_content_sha256",
    "access_scope", "exposure_policy", "ingest_status", "content_review_status",
    "team_review_status", "source_path"
  ],
  "properties": {
    "schema_version": {"const": "reference_chunk.v0"},
    "chunk_id": {"type": "string", "minLength": 1},
    "reference_id": {"type": "string", "pattern": "^TERM-[0-9]{3}$"},
    "reference_type": {"const": "IT_GLOSSARY"},
    "chunk_no": {"type": "integer", "minimum": 1},
    "document_type": {"const": "REFERENCE"},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "access_scope": {"const": "EMPLOYEE"},
    "exposure_policy": {"const": "QUOTABLE"},
    "ingest_status": {"enum": ["PENDING", "APPROVED", "BLOCKED"]},
    "content_review_status": {"enum": ["AI_DRAFT", "OWNER_CONFIRMED", "REJECTED"]},
    "team_review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]},
    "source_path": {"type": "string", "minLength": 1}
  }
}

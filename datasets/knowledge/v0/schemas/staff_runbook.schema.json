{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hops.local/schemas/staff_runbook_v0.schema.json",
  "title": "Hops STAFF_RUNBOOK v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "runbook_id", "version_no", "title", "language", "status",
    "document_type", "data_split", "is_synthetic", "service", "ownership", "access",
    "tool_binding", "scenario_validation",
    "applicability", "symptoms", "diagnostic_steps", "cause_hypotheses",
    "guidance_steps", "staff_resolution_steps", "agent_handling", "verification",
    "escalation", "user_response", "provenance", "review"
  ],
  "properties": {
    "schema_version": {"const": "staff_runbook.v0"},
    "runbook_id": {"type": "string", "pattern": "^RB-[A-Z0-9-]+$"},
    "version_no": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "language": {"const": "ko"},
    "status": {"enum": ["DRAFT", "APPROVED", "DEPRECATED"]},
    "document_type": {"const": "STAFF_RUNBOOK"},
    "data_split": {"enum": ["RAG", "DEV", "EVAL"]},
    "is_synthetic": {"const": true},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "component_id"],
      "properties": {
        "service_id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_owner_department"],
      "properties": {
        "default_owner_department": {"$ref": "#/$defs/department"},
        "supporting_departments": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/department"}
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_scope", "exposure_policy", "ingest_status"],
      "properties": {
        "access_scope": {"const": "STAFF"},
        "exposure_policy": {"const": "INTERNAL_ONLY"},
        "ingest_status": {"enum": ["PENDING", "APPROVED", "BLOCKED"]}
      }
    },
    "tool_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "bound_step_ids", "note"],
      "properties": {
        "status": {"enum": ["PENDING", "READY", "NOT_REQUIRED"]},
        "bound_step_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DIA-[0-9]{2}$"}},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "scenario_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "validated_at", "case_ids"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "PASSED", "FAILED"]},
        "validated_at": {"type": ["string", "null"], "format": "date"},
        "case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "products", "assumptions", "out_of_scope"],
      "properties": {
        "environment": {"enum": ["DEMO_PORTAL", "HOPS_VIRTUAL_COMPANY"]},
        "products": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "assumptions": {"$ref": "#/$defs/nonEmptyStrings"},
        "out_of_scope": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "symptoms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symptom_id", "user_phrases", "observable_signals"],
        "properties": {
          "symptom_id": {"type": "string", "pattern": "^SYM-[0-9]{2}$"},
          "user_phrases": {"$ref": "#/$defs/nonEmptyStrings"},
          "observable_signals": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    },
    "diagnostic_steps": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/diagnosticStep"}
    },
    "cause_hypotheses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "cause_id", "description", "required_signals", "required_signal_ids",
          "contradictory_signals", "contradictory_signal_ids",
          "owner_department", "evidence_ids"
        ],
        "properties": {
          "cause_id": {"type": "string", "pattern": "^CAUSE-[0-9]{2}$"},
          "description": {"type": "string", "minLength": 1},
          "required_signals": {"$ref": "#/$defs/nonEmptyStrings"},
          "required_signal_ids": {"$ref": "#/$defs/requiredSignalIds"},
          "contradictory_signals": {"$ref": "#/$defs/nonEmptyStrings"},
          "contradictory_signal_ids": {"$ref": "#/$defs/signalIds"},
          "owner_department": {"$ref": "#/$defs/department"},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "guidance_steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "order", "when", "instruction", "expected_user_result", "if_not_resolved", "evidence_ids"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^GUID-[0-9]{2}$"},
          "order": {"type": "integer", "minimum": 1},
          "when": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1},
          "expected_user_result": {"type": "string", "minLength": 1},
          "if_not_resolved": {"type": "string", "minLength": 1},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "staff_resolution_steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "order", "actor", "instruction", "execution_mode", "approval_required", "verification", "evidence_ids"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^RES-[0-9]{2}$"},
          "order": {"type": "integer", "minimum": 1},
          "actor": {"const": "IT_STAFF"},
          "instruction": {"type": "string", "minLength": 1},
          "execution_mode": {"const": "HUMAN_ONLY"},
          "approval_required": {"type": "boolean"},
          "verification": {"type": "string", "minLength": 1},
          "rollback": {"type": ["string", "null"]},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "agent_handling": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_outcomes", "handoff_reasons", "prohibited_actions", "resolution_confirmation_sources"],
      "properties": {
        "allowed_outcomes": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"enum": ["GUIDE_USER", "HANDOFF"]},
          "allOf": [
            {"contains": {"const": "GUIDE_USER"}},
            {"contains": {"const": "HANDOFF"}}
          ]
        },
        "handoff_reasons": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"enum": ["INSUFFICIENT_EVIDENCE", "GUIDANCE_NOT_RESOLVED"]},
          "allOf": [
            {"contains": {"const": "INSUFFICIENT_EVIDENCE"}},
            {"contains": {"const": "GUIDANCE_NOT_RESOLVED"}}
          ]
        },
        "prohibited_actions": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {"enum": ["CODE_CHANGE", "CONFIG_CHANGE", "DEPLOY", "RESTART", "DB_WRITE"]},
          "allOf": [
            {"contains": {"const": "CODE_CHANGE"}},
            {"contains": {"const": "CONFIG_CHANGE"}},
            {"contains": {"const": "DEPLOY"}},
            {"contains": {"const": "RESTART"}},
            {"contains": {"const": "DB_WRITE"}}
          ]
        },
        "resolution_confirmation_sources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["USER_CONFIRMATION", "BACKEND_STATE"]}
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["success_signals", "failure_signals"],
      "properties": {
        "success_signals": {"$ref": "#/$defs/nonEmptyStrings"},
        "failure_signals": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "escalation": {
      "type": "object", "additionalProperties": false,
      "required": ["triggers", "target_department", "evidence_to_attach"],
      "properties": {
        "triggers": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_department": {"$ref": "#/$defs/department"},
        "evidence_to_attach": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "user_response": {
      "type": "object", "additionalProperties": false,
      "required": ["safe_summary_template", "prohibited_details"],
      "properties": {
        "safe_summary_template": {"type": "string", "minLength": 1},
        "prohibited_details": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_evidence_ids", "created_at"],
      "properties": {
        "source_type": {"const": "SYNTHESIZED_FROM_PUBLIC_EVIDENCE"},
        "source_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "created_at": {"type": "string", "format": "date"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["content_status", "reviewer", "reviewed_at", "team_review_status"],
      "properties": {
        "content_status": {"enum": ["PENDING", "OWNER_CONFIRMED", "REJECTED"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date"},
        "team_review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}
      }
    }
  },
  "$defs": {
    "department": {
      "enum": ["ACCOUNT_PERMISSION", "NETWORK", "BACKEND", "FRONTEND", "DB", "INFRA", "SYSTEM", "CS"]
    },
    "nonEmptyStrings": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidenceIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(PE-[0-9]{3}[A-D]?|GE-[0-9]{3})$"}
    },
    "requiredSignalIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SIG-[0-9]{3}$"}
    },
    "signalIds": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SIG-[0-9]{3}$"}
    },
    "diagnosticStep": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "order", "goal", "action", "safety_class", "expected_signals", "on_match", "on_mismatch", "evidence_ids"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^DIA-[0-9]{2}$"},
        "order": {"type": "integer", "minimum": 1},
        "goal": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "safety_class": {"const": "READ_ONLY"},
        "tool_query": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["tool_id", "operation", "parameters"],
          "properties": {
            "tool_id": {"type": "string", "minLength": 1},
            "operation": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        },
        "expected_signals": {"$ref": "#/$defs/nonEmptyStrings"},
        "on_match": {"type": "string", "minLength": 1},
        "on_mismatch": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    }
  }
}

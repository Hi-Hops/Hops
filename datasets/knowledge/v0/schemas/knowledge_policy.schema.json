{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hops.local/schemas/knowledge_policy.v0.json",
  "title": "Hops Knowledge POLICY v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version_no", "title", "language", "status", "document_type", "access", "purpose", "rules", "prohibitions", "related_artifacts", "provenance", "review"],
  "properties": {
    "schema_version": {"const": "knowledge_policy.v0"},
    "policy_id": {"type": "string", "pattern": "^POLICY-[A-Z0-9-]+$"},
    "version_no": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"const": "ko"},
    "status": {"enum": ["DRAFT", "APPROVED", "DEPRECATED"]},
    "document_type": {"const": "POLICY"},
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_scope", "exposure_policy", "ingest_status"],
      "properties": {
        "access_scope": {"const": "STAFF"},
        "exposure_policy": {"const": "INTERNAL_ONLY"},
        "ingest_status": {"enum": ["PENDING", "APPROVED", "BLOCKED"]}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "priority", "trigger", "agent_action", "final_authority", "enforcement", "required_evidence", "user_visible_behavior", "prohibited_outcomes"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]+$"},
          "priority": {"type": "integer", "minimum": 1},
          "trigger": {"type": "string", "minLength": 1},
          "agent_action": {"type": "string", "minLength": 1},
          "final_authority": {"enum": ["SPRING", "HUMAN", "DATA_TEAM"]},
          "enforcement": {"type": "string", "minLength": 1},
          "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "user_visible_behavior": {"type": "string", "minLength": 1},
          "prohibited_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guide_ids", "runbook_ids", "scenario_ids"],
      "properties": {
        "guide_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GUIDE-[A-Z0-9-]+$"}},
        "runbook_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RB-[A-Z0-9-]+$"}},
        "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(SCN|FLOW)-[A-Z0-9-]+$"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_policy_ids", "created_at"],
      "properties": {
        "source_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "created_at": {"type": "string", "format": "date"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_status", "reviewer", "reviewed_at", "team_review_status"],
      "properties": {
        "content_status": {"enum": ["AI_DRAFT", "OWNER_CONFIRMED", "REJECTED"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date"},
        "team_review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}
      }
    }
  }
}

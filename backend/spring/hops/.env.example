# 이 폴더에서 .env로 복사한다. Backend와 개발용 PostgreSQL 설정을 함께 관리한다.
# 필수 입력: POSTGRES_PASSWORD, HOPS_JWT_SECRET. 실제 값은 Git에 올리지 않는다.
# Compose가 POSTGRES_*를 DB 컨테이너와 Spring datasource에 각각 매핑한다.
POSTGRES_DB=hops
POSTGRES_USER=hops
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
# ASCII 기준 32자 이상의 임의 비밀키. 브라우저용 VITE_ 변수에 넣지 않는다.
HOPS_JWT_SECRET=
HOPS_AGENT_BASEURL=http://ai:8000
# AI→Spring 내부 API(Ticket 도구·지식 검색) 전용. 32바이트 이상 난수의 padding 없는 base64url.
# AI를 real 모드로 실행하면 필수이며, 비어 있으면 내부 API는 모두 401이다(scaffold는 비워도 된다).
# AI_SERVICE_TOKEN(Spring→AI, ai/.env)·사용자 JWT와 다른 값을 사용한다.
# 받는 쪽인 이 파일에 두면 Compose가 AI 컨테이너에도 같은 값을 전달하므로 ai/.env에 따로 넣지 않는다.
# 값 만들기: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
# Gradle·IntelliJ로 Spring을 직접 실행하면 이 파일을 읽지 않으므로 같은 값을 프로세스 환경변수로 넣는다.
SPRING_SERVICE_TOKEN=
# 비워두면 Frontend의 FRONTEND_PORT 기준으로 localhost·127.0.0.1 Origin을 허용한다.
HOPS_CORS_ALLOWEDORIGINS=
# 로컬 HTTP 개발은 false. HTTPS로 공개하는 환경은 true로 설정한다.
HOPS_AUTH_REFRESHCOOKIE_SECURE=false

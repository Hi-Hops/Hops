# 이 폴더에서 .env로 복사한다. 아래 주소는 루트 Compose의 컨테이너 네트워크 기준이다.
# 필수 입력: SPRING_DATASOURCE_PASSWORD, HOPS_JWT_SECRET. 실제 값은 Git에 올리지 않는다.
SPRING_PROFILES_ACTIVE=db
# infra/postgres/.env의 POSTGRES_DB·POSTGRES_USER·POSTGRES_PASSWORD와 맞춘다.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hops
SPRING_DATASOURCE_USERNAME=hops
SPRING_DATASOURCE_PASSWORD=
# ASCII 기준 32자 이상의 임의 비밀키. 브라우저용 VITE_ 변수에 넣지 않는다.
HOPS_JWT_SECRET=
HOPS_AGENT_BASEURL=http://ai:8000
SPRING_DATA_REDIS_HOST=redis
# 루트 .env의 FRONTEND_PORT를 바꾸면 두 Origin의 포트도 맞춘다.
HOPS_CORS_ALLOWEDORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로컬 HTTP 개발은 false. HTTPS로 공개하는 환경은 true로 설정한다.
HOPS_AUTH_REFRESHCOOKIE_SECURE=false

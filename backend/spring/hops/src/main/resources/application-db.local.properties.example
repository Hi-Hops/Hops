# 이 파일을 복사해 같은 폴더에 application-db.local.properties로 저장하고, 내 PC의 DB 정보로 바꾼다.
#   Mac:     cp application-db.local.properties.example application-db.local.properties
#   Windows: Copy-Item application-db.local.properties.example application-db.local.properties
# 복사한 파일은 git에 올라가지 않는다. 이 예시 파일에는 실제 비밀번호를 넣지 않는다.

spring.datasource.url=jdbc:postgresql://localhost:5432/hops
spring.datasource.username=hops
spring.datasource.password=여기에_내_PC_DB_비밀번호
